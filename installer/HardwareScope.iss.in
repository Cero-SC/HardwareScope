#define AppVersion "@PROJECT_VERSION@"
#define BuildDirectory "@CMAKE_CURRENT_BINARY_DIR@/Release"
#define SourceDirectory "@CMAKE_CURRENT_SOURCE_DIR@"

[Setup]
#ifdef SmokeTest
AppId={{0C23B63A-B419-46D3-BC34-F87742F64DB6}
PrivilegesRequired=lowest
OutputBaseFilename=HardwareScope-Setup-{#AppVersion}-smoke-x64
#else
#ifdef AdminSmokeTest
AppId={{B9E895D1-A80B-4C69-B5D6-F66B365BB338}
OutputBaseFilename=HardwareScope-Setup-{#AppVersion}-admin-smoke-x64
#else
AppId={{50EC77EE-2969-45F1-A6DB-A6D225C1BBF1}
OutputBaseFilename=HardwareScope-Setup-{#AppVersion}-x64
#endif
PrivilegesRequired=admin
#endif
AppName=HardwareScope
AppVersion={#AppVersion}
AppPublisher=HardwareScope Project
AppPublisherURL=https://github.com/Cero-SC/HardwareScope
AppSupportURL=https://github.com/Cero-SC/HardwareScope/issues
AppUpdatesURL=https://github.com/Cero-SC/HardwareScope/releases/latest
AppCopyright=Copyright (c) 2026 Cero-SC and HardwareScope contributors
VersionInfoCompany=HardwareScope Project
VersionInfoCopyright=Copyright (c) 2026 Cero-SC and HardwareScope contributors
VersionInfoDescription=HardwareScope installer
VersionInfoProductName=HardwareScope
VersionInfoProductVersion={#AppVersion}
VersionInfoVersion={#AppVersion}.0
DefaultDirName={autopf}\HardwareScope
DefaultGroupName=HardwareScope
DisableProgramGroupPage=yes
OutputDir=@CMAKE_CURRENT_SOURCE_DIR@/out/packages
SetupIconFile={#SourceDirectory}/resources/HardwareScope.ico
UninstallDisplayIcon={app}\HardwareScope.exe
LicenseFile=@CMAKE_CURRENT_SOURCE_DIR@/LICENSE.txt
Compression=lzma2/max
SolidCompression=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
CloseApplications=force
RestartApplications=no
ChangesAssociations=yes
WizardStyle=modern

[Files]
Source: "{#BuildDirectory}/HardwareScopeNative.exe"; DestDir: "{app}"; DestName: "HardwareScope.exe"; Flags: ignoreversion
Source: "{#BuildDirectory}/HardwareScopeNativeUpdater.exe"; DestDir: "{app}"; DestName: "HardwareScopeUpdater.exe"; Flags: ignoreversion
Source: "{#BuildDirectory}/HardwareScopeNativeSensorService.exe"; DestDir: "{app}"; DestName: "HardwareScopeSensorService.exe"; Flags: ignoreversion
Source: "{#SourceDirectory}/resources/HardwareScope.ico"; DestDir: "{app}"; DestName: "HardwareScope.ico"; Flags: ignoreversion
Source: "@CMAKE_CURRENT_SOURCE_DIR@/third_party/presentmon/PresentMon-2.4.1-x64.exe"; DestDir: "{app}"; DestName: "PresentMon.exe"; Flags: ignoreversion
Source: "@CMAKE_CURRENT_SOURCE_DIR@/LICENSE.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_CURRENT_SOURCE_DIR@/THIRD_PARTY_NOTICES.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_CURRENT_SOURCE_DIR@/PRIVACY.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_CURRENT_SOURCE_DIR@/CODE_SIGNING_POLICY.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDirectory}/resources/PawnIO-Modules-COPYING.txt"; DestDir: "{app}"; Flags: ignoreversion
#ifndef SmokeTest
Source: "{#SourceDirectory}/third_party/pawnio/PawnIO_setup.exe"; Flags: dontcopy
#endif

[Icons]
#ifdef SmokeTest
Name: "{app}\HardwareScope smoke shortcut"; Filename: "{app}\HardwareScope.exe"; WorkingDir: "{app}"; IconFilename: "{app}\HardwareScope.ico"
#else
#ifdef AdminSmokeTest
Name: "{app}\HardwareScope admin smoke shortcut"; Filename: "{app}\HardwareScope.exe"; WorkingDir: "{app}"; IconFilename: "{app}\HardwareScope.ico"
#else
Name: "{autodesktop}\HardwareScope"; Filename: "{app}\HardwareScope.exe"; WorkingDir: "{app}"; IconFilename: "{app}\HardwareScope.ico"
Name: "{group}\HardwareScope"; Filename: "{app}\HardwareScope.exe"; WorkingDir: "{app}"; IconFilename: "{app}\HardwareScope.ico"
Name: "{group}\Uninstall HardwareScope"; Filename: "{uninstallexe}"
#endif
#endif

[Run]
Filename: "{app}\HardwareScope.exe"; Description: "Launch HardwareScope"; WorkingDir: "{app}"; Flags: nowait postinstall skipifsilent runasoriginaluser

#ifndef SmokeTest
[UninstallRun]
Filename: "{app}\HardwareScopeSensorService.exe"; Parameters: "--uninstall"; Flags: runhidden waituntilterminated; RunOnceId: "RemoveHardwareScopeSensorService"
#endif

#ifndef SmokeTest
[Code]
function PawnIOReady(): Boolean;
var
  Version: String;
  PackedVersion: Int64;
begin
  Result := FileExists(ExpandConstant('{autopf}\PawnIO\PawnIOLib.dll')) and
    RegQueryStringValue(HKLM64, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PawnIO', 'DisplayVersion', Version);
  if Result then
    Result := StrToVersion(Version, PackedVersion);
  if Result then
    Result := ComparePackedVersion(PackedVersion, PackVersionComponents(2, 2, 0, 0)) >= 0;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  ServicePath: String;
  ResultCode: Integer;
  PawnSetup: String;
begin
  Result := '';
  if not PawnIOReady() then
  begin
    ExtractTemporaryFile('PawnIO_setup.exe');
    PawnSetup := ExpandConstant('{tmp}\PawnIO_setup.exe');
    if CompareText(GetSHA256OfFile(PawnSetup), '1F519A22E47187F70A1379A48CA604981C4FCF694F4E65B734AAA74A9FBA3032') <> 0 then
    begin
      Result := 'The bundled hardware-access prerequisite failed verification.';
      Exit;
    end;
    if not Exec(PawnSetup, '-install -silent', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    begin
      Result := 'Could not start the PawnIO hardware-access installer. HardwareScope was not replaced.';
      Exit;
    end;
    if (ResultCode <> 0) and (ResultCode <> 3010) then
    begin
      Result := Format('PawnIO installation failed (code %d). HardwareScope was not replaced.', [ResultCode]);
      Exit;
    end;
    if ResultCode = 3010 then
    begin
      NeedsRestart := True;
      Result := 'PawnIO requires a Windows restart. Restart and run HardwareScope Setup again.';
      Exit;
    end;
    if not PawnIOReady() then
    begin
      Result := 'PawnIO installation could not be verified. HardwareScope was not replaced.';
      Exit;
    end;
  end;
  ServicePath := ExpandConstant('{app}\HardwareScopeSensorService.exe');
  if FileExists(ServicePath) then
  begin
    if (not Exec(ServicePath, '--uninstall', '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then
      Result := 'HardwareScope could not stop the existing sensor service. Setup did not replace the installation.';
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  ResultCode: Integer;
begin
  if CurStep = ssPostInstall then
  begin
    if (not Exec(ExpandConstant('{app}\HardwareScopeSensorService.exe'), '--check-runtime', '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then
      RaiseException('The PawnIO driver could not be opened. Restart Windows and run Setup again to repair hardware sensor access.');
    if (not Exec(ExpandConstant('{app}\HardwareScopeSensorService.exe'), '--install', '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then
      RaiseException('HardwareScope could not install its read-only sensor service.');
  end;
end;
#endif
